# =============================================================================
# Slack Credentials (Socket Mode)
# =============================================================================
# Create a Slack App at https://api.slack.com/apps
# Enable Socket Mode under Settings > Socket Mode
# See README.md for detailed setup instructions

# Bot User OAuth Token (OAuth & Permissions > Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-your-token-here

# App-Level Token for Socket Mode (Basic Information > App-Level Tokens)
# Generate with scope: connections:write
SLACK_APP_TOKEN=xapp-your-token-here

# Channel ID where leads are posted (right-click channel > View channel details)
SLACK_CHANNEL_ID=C0123456789

# Optional: Channel ID for test posts
SLACK_TEST_CHANNEL_ID=

# =============================================================================
# LLM Configuration
# =============================================================================
# Default: Anthropic Claude (claude-sonnet-4-6)

ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL_NAME=claude-sonnet-4-6
#
# Optional: override max output tokens for all agents
LLM_MAX_TOKENS=4000

# =============================================================================
# Runtime Options
# =============================================================================
# DRY_RUN=true  -> Log classifications but don't post to Slack
# DRY_RUN=false -> Post classification replies to message threads

DRY_RUN=true
DEBUG=true

# =============================================================================
# Observability (Logfire)
# =============================================================================
# Get your write token at https://logfire.pydantic.dev/
# Project Settings > Write Tokens > Create Write Token

LOGFIRE_TOKEN=

# =============================================================================
# Prompt Configuration
# =============================================================================
# Customize lead classification behavior for your deployment.
# Points to a JSON file - see prompt_config.example.json for all options.
#
# The file will be auto-discovered if named prompt_config.json in the
# current directory. Use PROMPT_CONFIG_PATH to specify a different location.

# PROMPT_CONFIG_PATH=./prompt_config.json

# =============================================================================
# Lead briefs (full analysis as an HTML page in S3, served over HTTP)
# =============================================================================
# The Slack card carries the decision; the brief carries the evidence. Every
# analysis is stored as a new version, so you can always go back and see what
# an earlier run concluded.
#
# AWS credentials are NOT configured here: the S3 client uses the default
# boto3 chain (EC2 instance role, then env vars, then ~/.aws profile).

# BRIEFS_ENABLED=true
# BRIEFS_S3_BUCKET=onesix-leads-agent-briefs
# BRIEFS_S3_PREFIX=briefs
# BRIEFS_S3_REGION=us-east-1

# Origin the briefs are reachable at. Must be set for links to be clickable
# from Slack. On the Tailscale host, use the tailnet address.
# BRIEFS_BASE_URL=http://100.79.160.6:8080

# Listener. BRIEFS_HTTP_HOST is the bind address *inside* the container and
# should stay 0.0.0.0; who can reach it is decided by BRIEFS_BIND_ADDR below.
# BRIEFS_HTTP_ENABLED=true
# BRIEFS_HTTP_HOST=0.0.0.0
# BRIEFS_HTTP_PORT=8080

# Host address docker-compose publishes the port on. Defaults to 127.0.0.1
# (nothing reachable off-box). Set to the Tailscale IP to serve the tailnet.
# BRIEFS_BIND_ADDR=100.79.160.6
